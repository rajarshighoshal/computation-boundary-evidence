{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Connected scientific interpretation of code-owned computations",
  "type": "object",
  "required": ["schema_version", "purpose", "computations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "object-enrichment-2.0"},
    "purpose": {"$ref": "#/$defs/claim"},
    "computations": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/computation"}}
  },
  "$defs": {
    "claim": {
      "type": "object", "required": ["text", "source_ids"], "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 600},
        "source_ids": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
                       "items": {"type": "string", "minLength": 1}}
      }
    },
    "computation": {
      "type": "object", "required": ["computation_id", "meaning", "quantities", "conventions", "assumptions"],
      "additionalProperties": false,
      "properties": {
        "computation_id": {"type": "string", "minLength": 1},
        "meaning": {"$ref": "#/$defs/claim"},
        "quantities": {
          "type": "array", "maxItems": 8,
          "items": {"type": "object", "required": ["object_id", "meaning"], "additionalProperties": false,
                    "properties": {"object_id": {"type": "string", "minLength": 1}, "meaning": {"$ref": "#/$defs/claim"}}}
        },
        "conventions": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/claim"}},
        "assumptions": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 240}}
      }
    }
  }
}
