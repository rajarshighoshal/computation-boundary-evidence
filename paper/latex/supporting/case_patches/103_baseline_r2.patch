+    def get_Qbar_matrix(self, mid_ref, theta: float) -> np.ndarray:
+        """theta must be in radians"""
+        S2, unused_S3 = get_mat_props_S(mid_ref)
+        T = get_2d_plate_transform(theta)
+        Tinv = np.linalg.inv(T)
+        Q = np.linalg.inv(S2)
+
+        # [Qbar] = [T^-1][Q][T^-T]
+        # [T^-T] = [R][T][R^-1] = [T^-1].T
+        Qbar = np.linalg.multi_dot([Tinv, Q, Tinv.T])
+        return Qbar
+
+    def get_Sbar_matrix(self, mid_ref, theta: float) -> np.ndarray:
+        """theta must be in radians"""
+        Qbar = self.get_Qbar_matrix(mid_ref, theta)
+        Sbar = np.linalg.inv(Qbar)
+        return Sbar
+
+    def get_ABD_matrices(self, theta_offset: float=0.) -> np.ndarray:
+        """
+        Gets the ABD matrix using classical laminated plate theory.
+
+        The :math:`A`, :math:`B`, and :math:`D` blocks are assembled from
+        every ply of the physical laminate.  For a symmetric laminate
+        (``lam='SYM'``) the stored plies are mirrored about the reference
+        surface, so the material reference for a mirrored ply is obtained
+        through :meth:`_adjust_ply_id` rather than by position.
+
+        Parameters
+        ----------
+        theta_offset : float
+            rotates the ABD matrix; measured in degrees
+
+        """
+        thicknesses = self.get_thicknesses()
+        thetad = self.get_thetas() + theta_offset
+        theta = np.radians(thetad)
+
+        csum = np.cumsum(thicknesses)
+        z0 = self.z0 + np.hstack([0., csum[:-1]])
+        z1 = self.z0 + csum
+        assert len(z0) == len(z1)
+        zmeans = (z0 + z1) / 2.
+
+        # A11 A12 A16
+        # A12 A22 A26
+        # A16 A26 A66
+        A = np.zeros((3, 3), dtype='float64')
+        B = np.zeros((3, 3), dtype='float64')
+        D = np.zeros((3, 3), dtype='float64')
+
+        mids_ref = self.mids_ref
+        if mids_ref is None:
+            msg = ('%s pid=%s; get_ABD_matrices requires cross-referenced '
+                   'materials, but mids_ref is None' % (self.type, self.pid))
+            raise RuntimeError(msg)
+
+        # ``thicknesses``/``theta``/``z*`` are already expanded to the full
+        # physical stack; ``mids_ref`` only stores the plies that were
+        # written down, so index it through _adjust_ply_id (which mirrors
+        # ply ids for symmetric laminates).
+        for iply in range(self.nplies):
+            iply_ref = self._adjust_ply_id(iply)
+            mid_ref = mids_ref[iply_ref]
+            thetai = theta[iply]
+            thickness = thicknesses[iply]
+            Qbar = self.get_Qbar_matrix(mid_ref, thetai)
+            A += Qbar * thickness
+            B += Qbar * thickness * zmeans[iply]
+            D += Qbar * thickness * (z1[iply] ** 3 - z0[iply] ** 3)
+            #N += Q * alpha * thickness
+            #M += Q * alpha * thickness * zmean
+        B /= 2.
+        D /= 3.
+        #M /= 2.
+        ABD = np.block([
+            [A, B],
+            [B, D],
+        ])
+        np.set_printoptions(linewidth=120, suppress=True)
+        #print(ABD)
+        return ABD
+
