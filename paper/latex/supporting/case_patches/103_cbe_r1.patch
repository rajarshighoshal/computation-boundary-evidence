+    def get_material_refs(self) -> List[Material]:
+        """
+        Gets the material reference (MAT8/MAT1/...) for every ply of the
+        laminate, ordered from the bottom surface to the top surface.
+
+        For a symmetric laminate (``lam='SYM'``) the stored plies are mirrored
+        about the mid-surface, so the returned list contains
+        ``self.nplies`` entries even though only ``len(self.thicknesses)``
+        materials were stored.  This keeps the material references aligned
+        with the expanded thickness/theta arrays returned by
+        :meth:`get_thicknesses` and :meth:`get_thetas`.
+
+        Returns
+        -------
+        mids_ref : List[Material]
+            the material for each ply (``None`` if not cross-referenced)
+
+        """
+        mids_ref = self.mids_ref
+        if mids_ref is None:
+            return None
+        nplies = self.nplies
+        if len(mids_ref) == nplies:
+            return list(mids_ref)
+        return [mids_ref[self._adjust_ply_id(iply)] for iply in range(nplies)]
+
     def get_material_id(self, iply: int) -> int:
         iply = self._adjust_ply_id(iply)
         mid = self.mids[iply]
