+def _mode_sampling(
+    images,
+    mesh,
+    affine,
+    kind="auto",
+    radius=3.0,
+    n_points=None,
+    mask=None,
+    inner_mesh=None,
+    depth=None,
+):
+    """In each image, measure the modal intensity at each node of the mesh.
+
+    Image intensity at each sample point is that of the nearest voxel. The
+    value associated with a mesh vertex is the most frequent intensity among
+    the samples. This is appropriate for label or atlas images, for which
+    averaging would produce values that do not correspond to any label.
+    A 2-d array is returned, where each row corresponds to an image and each
+    column to a mesh vertex.
+    See documentation of vol_to_surf for details.
+
+    """
+    sample_locations = _sample_locations(
+        mesh,
+        affine,
+        kind=kind,
+        radius=radius,
+        n_points=n_points,
+        inner_mesh=inner_mesh,
+        depth=depth,
+    )
+    sample_locations = np.asarray(np.round(sample_locations), dtype=int)
+    n_vertices, n_points, _ = sample_locations.shape
+    masked = _masked_indices(
+        np.vstack(sample_locations), images[0].shape, mask=mask
+    ).reshape(n_vertices, n_points)
+    sample_locations = np.rollaxis(sample_locations, -1)
+    sample_indices = np.ravel_multi_index(
+        sample_locations, images[0].shape, mode="clip"
+    )
+    texture = np.empty((len(images), n_vertices), dtype=float)
+    for i, img in enumerate(images):
+        samples = img.ravel()[sample_indices].astype(float, copy=False)
+        if masked.any():
+            samples = samples.copy()
+            samples[masked] = np.nan
+        with warnings.catch_warnings():
+            warnings.simplefilter("ignore")
+            modes = stats.mode(
+                samples, axis=1, nan_policy="omit"
+            ).mode
+        texture[i] = modes
+    return texture
+
+
+# Keep private aliases for callers that refer to the sampler by a descriptive
+# name.  The public API uses interpolation="mode".
+_mode_voxel_sampling = _mode_sampling
+_majority_voxel_sampling = _mode_sampling
+_majority_sampling = _mode_sampling
+_majority_voting_sampling = _mode_sampling
+_most_frequent_voxel_sampling = _mode_sampling
+_modal_voxel_sampling = _mode_sampling
